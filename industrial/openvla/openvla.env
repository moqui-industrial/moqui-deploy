# OpenVLA service defaults for Moqui remote-rest invocation.
# Override these values per environment as needed.
OPENVLA_MODEL_ID=openvla/openvla-7b
OPENVLA_DEVICE=cuda:0
OPENVLA_TORCH_DTYPE=bfloat16
OPENVLA_ATTN_IMPLEMENTATION=flash_attention_2
OPENVLA_UNNORM_KEY=bridge_orig
OPENVLA_GROUNDING_MODEL_ID=google/owlv2-base-patch16-ensemble
OPENVLA_GROUNDING_DEVICE=cuda:0
OPENVLA_GROUNDING_BOX_THRESHOLD=0.12
OPENVLA_GROUNDING_TEXT_THRESHOLD=0.10
OPENVLA_GROUNDING_MAX_LABELS=8
# Optional heuristic projection from image-space grounding to a target pose vector.
# This is not a camera calibration; it is only a configurable bridge if you want
# OpenVLA grounding to emit an approximate pose vector that Moqui can pass forward.
OPENVLA_TARGET_POSE_DEFAULTS=0,0,0,0,0,0
OPENVLA_TARGET_POSE_SCALE=1,1,1,0,0,0
OPENVLA_TARGET_POSE_BIAS=0,0,0,0,0,0
OPENVLA_PORT=8000
